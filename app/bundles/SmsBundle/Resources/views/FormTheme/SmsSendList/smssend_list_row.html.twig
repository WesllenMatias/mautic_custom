{% block smssend_list_row %}
<div class="row">
    <div class="col-xs-12 pr-0">
        {{ form_row(form.sms) }}
        <div class="mb-lg d-flex gap-2">
            {% if form.newSmsButton is defined %}
                {{ form_row(form.newSmsButton) }}
            {% endif %}
            {% if form.editSmsButton is defined %}
                {{ form_row(form.editSmsButton) }}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block _smssend_list_row %}
{{ block('smssend_list_row') }}
{% endblock %}
